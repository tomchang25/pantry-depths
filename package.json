{
  "name": "pantry-depths",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture": "node dev/tools/capture-scenes.mjs",
    "sfx:export": "node node_modules/vite-node/vite-node.mjs --config dev/tools/vite-node.config.ts dev/tools/export-sfx-review.ts",
    "capture:page": "node dev/tools/capture-page.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:boundaries": "depcruise src dev/tools --config .dependency-cruiser.cjs",
    "check:ownership": "node dev/tools/check-ownership.mjs",
    "check:governance": "python dev/tools/check_governance.py && python dev/foundation/tools/verify_consumer.py --root .",
    "verify": "npm run check:ownership && npm run format:check && npm run typecheck && npm run lint && npm run check:boundaries && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.15",
    "@types/three": "^0.185.1",
    "dependency-cruiser": "^18.1.0",
    "oxlint": "1.74.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
