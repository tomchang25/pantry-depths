#!/bin/sh
#
# commit-msg — structural gate for Pantry Depths commit messages.
#
# Register is a human judgement and lives in dev/agent_rules/git_operations.md; this
# hook never tries to make it. What it catches is damage no reader would have written
# on purpose: a message mangled by shell quoting, a subject that is not a subject, and
# the attribution trailers the project bans but an agent's defaults keep supplying.
#
# Installed once per clone:
#   git config core.hooksPath dev/tools/githooks

set -eu

TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
SUBJECT_WORD_LIMIT=40
MESSAGE_WORD_LIMIT=400

message=$(grep -v '^#' "$1" || true)
subject=$(printf '%s\n' "$message" | sed -n '1p')
second=$(printf '%s\n' "$message" | sed -n '2p')
failed=0

reject() {
	printf 'commit-msg: %s\n' "$1" >&2
	failed=1
}

# Leading blanks in wc output would break the numeric comparisons below.
words() {
	printf '%s\n' "$1" | wc -w | tr -d '[:space:]'
}

squeeze() {
	printf '%s' "$1" | tr -d '[:space:]'
}

if [ -z "$(squeeze "$subject")" ]; then
	reject 'the subject line is empty'
else
	debris=0
	case "$subject" in
	'@' | "'@" | "@'" | '"@' | '@"' | '"' | "'" | 'EOF' | '<<EOF' | 'PS>')
		debris=1
		;;
	esac

	subject_words=$(words "$subject")

	if [ "$debris" -eq 1 ]; then
		reject "the subject is shell quoting debris: ${subject}"
		reject 'one shell'"'"'s multi-line string delimiters are literal text in another, so the real subject is now on line 2'
	elif ! printf '%s\n' "$subject" | grep -Eq "^(${TYPES})(\([a-z0-9._/-]+\))?!?: .+"; then
		reject "the subject is not a conventional commit subject: ${subject}"
	fi

	if [ "$subject_words" -ge "$SUBJECT_WORD_LIMIT" ]; then
		reject "the subject is ${subject_words} words; the limit is ${SUBJECT_WORD_LIMIT}"
	fi
fi

if [ -n "$(squeeze "$second")" ]; then
	reject "line 2 must be blank, and reads: ${second}"
fi

if printf '%s\n' "$message" | grep -Eqi '^(co-authored-by|signed-off-by):'; then
	reject 'the message carries an authorship trailer; Git metadata already records authorship'
fi

if printf '%s\n' "$message" | grep -Eqi '^[^a-z0-9]*generated with'; then
	reject 'the message names the tool that produced the change'
fi

message_words=$(words "$message")
if [ "$message_words" -ge "$MESSAGE_WORD_LIMIT" ]; then
	reject "the message is ${message_words} words; the limit is ${MESSAGE_WORD_LIMIT}"
fi

if [ "$failed" -ne 0 ]; then
	printf '\n' >&2
	printf 'Deliver the message as a file — git commit -F <path> — never as -m or a\n' >&2
	printf 'multi-line string built in the shell. See dev/agent_rules/git_operations.md.\n' >&2
	printf 'The rejected message is preserved in .git/COMMIT_EDITMSG\n' >&2
	exit 1
fi

exit 0
